{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/relic-yuexi/LubanCode/main/catalog/providers.schema.json",
  "title": "LubanCode provider catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "providers"],
  "properties": {
    "schema_version": { "const": 2 },
    "revision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "wire", "base_url", "key_env", "default_model", "models"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "wire": { "enum": ["anthropic-messages", "openai-responses", "openai-chat-completions", "google-generate-content"] },
        "base_url": { "type": "string", "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1)([:/]|$))" },
        "key_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "default_model": { "type": "string", "minLength": 1 },
        "model_reasoning_effort": { "type": "string" },
        "native_web_search": { "type": "boolean" },
        "stream_usage": { "type": "boolean" },
        "reasoning_replay": { "enum": ["never", "tool_episode"] },
        "reasoning_delta_field": { "type": "string", "minLength": 1 },
        "reasoning_replay_field": { "type": "string", "minLength": 1 },
        "reasoning_dialect": { "$ref": "#/$defs/reasoning_dialect" },
        "docs_url": { "type": "string", "pattern": "^https://" },
        "extra_body": { "type": "object" },
        "extra_headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "models": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/model" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "context_window": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "string" }] },
        "max_output": { "type": "integer", "minimum": 1 },
        "default_think": { "type": "string" },
        "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "deferred_tools": { "$ref": "#/$defs/deferred_tools" },
        "reasoning": { "$ref": "#/$defs/reasoning" }
      }
    },
    "deferred_tools": {
      "type": "object",
      "additionalProperties": false,
      "description": "模型级原生引用能力(动态工具 P3):declared 才允许装配层开 deferred_tool_mode=native_reference。目录不写 = 不声明,不按厂名猜。",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["native_reference"] },
        "tool_reference": { "type": "boolean" },
        "server_tool_search": { "enum": ["regex", "bm25"] }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["effort", "toggle", "budget"] },
              "values": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "min": { "type": "integer", "minimum": 0 },
              "max": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "supportedEfforts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "thinkingTokenLimits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "wireDialect": { "enum": ["effort", "budget"] },
        "dialect": { "$ref": "#/$defs/reasoning_dialect" }
      }
    },
    "reasoning_dialect": {
      "type": "object",
      "additionalProperties": false,
      "description": "落线方言:中立推理能力在具体 wire 上的精确形状。模型级出现的字段逐项覆写 provider 级;与所在 wire 不匹配的组合在 catalog parse 阶段报错。字段语义见 src/api/reasoning.hpp 的 ReasoningWireDialect。",
      "properties": {
        "toggle": { "enum": ["none", "enable_thinking_bool", "thinking_type", "include_thoughts", "chat_template_kwargs_enable_thinking"] },
        "toggle_on": { "enum": ["true", "false", "enabled", "adaptive", "disabled"] },
        "toggle_off": { "enum": ["true", "false", "enabled", "adaptive", "disabled"] },
        "effort_path": { "enum": ["none", "reasoning.effort", "reasoning_effort", "output_config.effort", "thinkingLevel"] },
        "effort_param": { "type": "string", "minLength": 1 },
        "budget_path": { "enum": ["none", "thinking_budget", "thinking.budget_tokens", "thinkingBudget"] },
        "delta": { "enum": ["none", "reasoning_content", "reasoning", "reasoning_details", "reasoning_summary", "anthropic_thinking_block", "gemini_thought_part"] },
        "replay": { "enum": ["never", "tool_episode", "always"] },
        "replay_field": { "type": "string", "minLength": 1 },
        "history_control": { "enum": ["none", "thinking_keep"] },
        "history_all_value": { "type": "string", "minLength": 1 },
        "signature_required": { "type": "boolean" },
        "verified": { "type": "boolean" }
      }
    }
  }
}
