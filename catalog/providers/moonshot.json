{
  "platform": "moonshot",
  "providers": {
    "moonshot": {
      "name": "Moonshot AI",
      "description": "Moonshot AI OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://api.moonshot.cn/v1",
      "key_env": "MOONSHOT_API_KEY",
      "default_model": "kimi-k2.6",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://platform.moonshot.cn/docs/",
      "models": {
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              }
            ],
            "dialect": {
              "effort_path": "none",
              "replay": "tool_episode",
              "history_control": "thinking_keep",
              "verified": true
            }
          }
        },
        "kimi-k3": {
          "name": "Kimi K3",
          "context_window": 1048576,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "low",
                  "high",
                  "max"
                ]
              }
            ],
            "supportedEfforts": [
              "low",
              "high",
              "max"
            ],
            "dialect": {
              "toggle": "none",
              "replay": "always",
              "history_control": "none",
              "verified": true
            }
          }
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              }
            ],
            "dialect": {
              "effort_path": "none",
              "replay": "never",
              "history_control": "none",
              "verified": true
            }
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "dialect": {
              "toggle": "none",
              "effort_path": "none",
              "budget_path": "none",
              "replay": "always",
              "history_control": "none",
              "verified": true
            }
          }
        },
        "kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code HighSpeed",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "dialect": {
              "toggle": "none",
              "effort_path": "none",
              "budget_path": "none",
              "replay": "always",
              "history_control": "none",
              "verified": true
            }
          }
        }
      }
    },
    "moonshot-anthropic": {
      "name": "Moonshot AI (Anthropic)",
      "description": "Moonshot AI Anthropic Messages API",
      "wire": "anthropic-messages",
      "base_url": "https://api.moonshot.cn/anthropic",
      "key_env": "MOONSHOT_API_KEY",
      "default_model": "kimi-k2.6",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "budget_path": "thinking.budget_tokens",
        "delta": "anthropic_thinking_block",
        "replay": "never",
        "signature_required": true,
        "verified": false
      },
      "docs_url": "https://platform.moonshot.cn/docs/",
      "extra_headers": {
        "Authorization": "",
        "x-api-key": "${LUBANCODE_API_KEY}",
        "anthropic-version": "2023-06-01"
      },
      "models": {
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "default_think": "high",
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              {
                "kind": "toggle"
              },
              {
                "kind": "budget",
                "max": 30720,
                "min": 0
              }
            ],
            "supportedEfforts": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "thinkingTokenLimits": {
              "max": 30720,
              "min": 0
            }
          }
        },
        "kimi-k3": {
          "name": "Kimi K3",
          "context_window": 1048576,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "low",
                  "high",
                  "max"
                ]
              },
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "low",
              "high",
              "max",
              "none"
            ]
          }
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              },
              {
                "kind": "budget",
                "max": 30720,
                "min": 0
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ],
            "thinkingTokenLimits": {
              "max": 30720,
              "min": 0
            }
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "budget",
                "max": 30720,
                "min": 0
              }
            ],
            "thinkingTokenLimits": {
              "max": 30720,
              "min": 0
            }
          }
        },
        "kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code HighSpeed",
          "context_window": 262144,
          "max_output": 262144,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "budget",
                "max": 30720,
                "min": 0
              }
            ],
            "thinkingTokenLimits": {
              "max": 30720,
              "min": 0
            }
          }
        }
      }
    }
  }
}
