{
  "platform": "mimo",
  "providers": {
    "mimo": {
      "name": "Xiaomi MiMo",
      "description": "Xiaomi MiMo OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://api.xiaomimimo.com/v1",
      "key_env": "MIMO_API_KEY",
      "default_model": "mimo-v2-5-pro",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://mimo.mi.com/docs/zh-CN",
      "models": {
        "mimo-v2-5": {
          "name": "MiMo-V2.5",
          "context_window": 1050000,
          "max_output": 131100,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "audio-recognition": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ]
          }
        },
        "mimo-v2-5-pro": {
          "name": "MiMo-V2.5-Pro",
          "context_window": 1050000,
          "max_output": 131072,
