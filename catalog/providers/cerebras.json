{
  "platform": "cerebras",
  "providers": {
    "cerebras": {
      "name": "Cerebras AI",
      "description": "Cerebras AI OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://api.cerebras.ai/v1",
      "key_env": "CEREBRAS_API_KEY",
      "default_model": "gemma-4-31b",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://inference-docs.cerebras.ai/introduction",
      "models": {
        "gemma-4-31b": {
          "name": "Gemma 4 31B IT"
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS-120B",
          "context_window": 131072,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            ],
            "supportedEfforts": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    }
  }
}
