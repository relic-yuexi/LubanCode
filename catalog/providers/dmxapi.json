{
  "platform": "dmxapi",
  "providers": {
    "dmxapi": {
      "name": "DMXAPI",
      "description": "DMXAPI OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://www.dmxapi.cn/v1",
      "key_env": "DMXAPI_API_KEY",
      "default_model": "gemini-2.5-flash-image",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://doc.dmxapi.cn/",
      "models": {
        "gemini-2.5-flash-image": {
          "name": "Gemini 2.5-flash-image",
          "context_window": 32768,
          "capabilities": {
            "reasoning": true,
            "image": true,
            "image-generation": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "budget",
                "max": 24576,
                "min": 0
              },
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ],
            "thinkingTokenLimits": {
              "max": 24576,
              "min": 0
            },
            "wireDialect": "budget"
