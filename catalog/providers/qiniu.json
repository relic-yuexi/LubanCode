{
  "platform": "qiniu",
  "providers": {
    "qiniu": {
      "name": "Qiniu",
      "description": "Qiniu OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://api.qnaigc.com/v1",
      "key_env": "QINIU_API_KEY",
      "default_model": "mimo-v2-flash",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://developer.qiniu.com/aitokenapi",
      "models": {
        "mimo-v2-flash": {
          "name": "MiMo-V2-Flash",
          "context_window": 262144,
          "max_output": 65536,
          "capabilities": {
            "tools": true,
            "reasoning": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ]
          }
        }
      }
    },
    "qiniu-anthropic": {
      "name": "Qiniu (Anthropic)",
      "description": "Qiniu Anthropic Messages API",
      "wire": "anthropic-messages",
      "base_url": "https://api.qnaigc.com",
      "key_env": "QINIU_API_KEY",
      "default_model": "mimo-v2-flash",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "budget_path": "thinking.budget_tokens",
        "delta": "anthropic_thinking_block",
        "replay": "never",
        "signature_required": true,
        "verified": false
      },
      "docs_url": "https://developer.qiniu.com/aitokenapi",
      "extra_headers": {
        "Authorization": "",
        "x-api-key": "${LUBANCODE_API_KEY}",
        "anthropic-version": "2023-06-01"
      },
      "models": {
        "mimo-v2-flash": {
          "name": "MiMo-V2-Flash",
          "context_window": 262144,
          "max_output": 65536,
          "capabilities": {
            "tools": true,
            "reasoning": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ]
          }
        }
      }
    }
  }
}
