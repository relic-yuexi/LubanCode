{
  "platform": "longcat",
  "providers": {
    "longcat": {
      "name": "LongCat",
      "description": "LongCat OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://api.longcat.chat/openai",
      "key_env": "LONGCAT_API_KEY",
      "default_model": "LongCat-2.0",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://longcat.chat/platform/docs/zh/",
      "models": {
        "LongCat-2.0": {
          "name": "LongCat-2.0",
          "context_window": 1048576,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ]
          }
        }
      }
    },
    "longcat-anthropic": {
      "name": "LongCat (Anthropic)",
      "description": "LongCat Anthropic Messages API",
      "wire": "anthropic-messages",
      "base_url": "https://api.longcat.chat/anthropic",
      "key_env": "LONGCAT_API_KEY",
      "default_model": "LongCat-2.0",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "budget_path": "thinking.budget_tokens",
        "delta": "anthropic_thinking_block",
        "replay": "never",
        "signature_required": true,
        "verified": false
      },
      "docs_url": "https://longcat.chat/platform/docs/zh/",
      "extra_headers": {
        "Authorization": "",
        "x-api-key": "${LUBANCODE_API_KEY}",
        "anthropic-version": "2023-06-01"
      },
      "models": {
        "LongCat-2.0": {
          "name": "LongCat-2.0",
          "context_window": 1048576,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ]
          }
        }
      }
    }
  }
}
