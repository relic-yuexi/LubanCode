{
  "platform": "zhipu",
  "providers": {
    "zhipu": {
      "name": "ZhiPu",
      "description": "ZhiPu OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "key_env": "ZHIPUAI_API_KEY",
      "default_model": "glm-5.2",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://docs.bigmodel.cn/",
      "extra_body": {
        "tool_stream": true
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3",
          "context_window": 1048576,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "off_unsupported": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "low",
                  "high",
                  "max"
                ]
              }
            ],
            "supportedEfforts": [
              "low",
              "high",
              "max"
            ]
          }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "context_window": 1048576,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "off_unsupported": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "low",
                  "high",
                  "max"
                ]
              }
            ],
            "supportedEfforts": [
              "low",
              "high",
              "max"
            ]
          }
        },
        "glm-5.2": {
          "name": "GLM-5.2",
          "context_window": 1048576,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true
          },
          "default_think": "max",
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "high",
                  "max",
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "xhigh"
                ]
              },
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "high",
              "max",
              "none",
              "minimal",
              "low",
              "medium",
              "xhigh"
            ]
          }
        },
        "glm-5.2-fast": {
          "name": "GLM 5.2 Fast",
          "context_window": 1000000,
          "max_output": 128000,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "high",
                  "xhigh"
                ]
              },
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "high",
              "xhigh",
              "none"
            ]
          }
        }
      }
    },
    "zhipu-anthropic": {
      "name": "ZhiPu (Anthropic)",
      "description": "ZhiPu Anthropic Messages API",
      "wire": "anthropic-messages",
      "base_url": "https://open.bigmodel.cn/api/anthropic",
