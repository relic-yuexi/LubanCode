{
  "platform": "groq",
  "providers": {
    "groq": {
      "name": "Groq",
      "description": "Groq OpenAI-compatible Chat API",
      "wire": "openai-chat-completions",
      "base_url": "https://api.groq.com/openai",
      "key_env": "GROQ_API_KEY",
      "default_model": "meta-llama/llama-prompt-guard-2-22m",
      "reasoning_dialect": {
        "toggle": "thinking_type",
        "toggle_on": "enabled",
        "toggle_off": "disabled",
        "effort_path": "reasoning_effort",
        "delta": "reasoning_content",
        "replay": "never",
        "verified": false
      },
      "docs_url": "https://console.groq.com/docs/quickstart",
      "models": {
        "allam-2-7b": {
          "name": "ALLaM-2-7b"
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS-120B",
          "context_window": 131072,
          "max_output": 131072,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            ],
            "supportedEfforts": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "openai/gpt-oss-20b": {
          "name": "GPT OSS 20B",
          "context_window": 131072,
          "max_output": 32768,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true
          }
        },
        "openai/gpt-oss-safeguard-20b": {
          "name": "GPT OSS Safeguard 20B",
          "context_window": 131072,
          "max_output": 65536,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "effort",
                "values": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            ],
            "supportedEfforts": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "llama-3.1-8b-instant": {
          "name": "Llama 3.1 8B"
        },
        "llama-3.3-70b-versatile": {
          "name": "Llama 3.3 70B"
        },
        "meta-llama/llama-prompt-guard-2-22m": {
          "name": "Llama Prompt Guard 2 22M"
        },
        "meta-llama/llama-prompt-guard-2-86m": {
          "name": "Prompt Guard 2 86M"
        },
        "qwen/qwen3.6-27b": {
          "name": "Qwen3.6 27B",
          "context_window": 262144,
          "max_output": 256000,
          "capabilities": {
            "tools": true,
            "reasoning": true,
            "structured_output": true,
            "image": true,
            "video": true,
            "audio-recognition": true,
            "video-recognition": true,
            "file_input": true
          },
          "reasoning": {
            "controls": [
              {
                "kind": "budget",
                "max": 131072,
                "min": 1
              },
              {
                "kind": "toggle"
              }
            ],
            "supportedEfforts": [
              "none",
              "auto"
            ],
            "thinkingTokenLimits": {
              "max": 131072,
              "min": 1
            }
          }
        }
      }
    }
  }
}
