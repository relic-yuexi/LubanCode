{
  "schema_version": 1,
  "revision": "2026-08-16",
  "providers": {
    "openai": {
      "name": "OpenAI",
      "description": "OpenAI Responses API",
      "wire": "responses",
      "base_url": "https://api.openai.com/v1",
      "key_env": "OPENAI_API_KEY",
      "default_model": "gpt-5.4",
      "docs_url": "https://developers.openai.com/api/docs/guides/migrate-to-responses",
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4",
          "context_window": 1050000,
          "max_output": 128000,
          "default_think": "high",
          "capabilities": { "reasoning": true, "tools": true, "image": true, "structured_output": true },
          "variants": {
            "low": { "description": "较快" },
            "medium": { "description": "均衡" },
            "high": { "description": "较深" },
            "xhigh": { "description": "最深" }
          }
        }
      }
    },
    "anthropic": {
      "name": "Anthropic",
      "description": "Claude Messages API",
      "wire": "anthropic",
      "base_url": "https://api.anthropic.com",
      "key_env": "ANTHROPIC_API_KEY",
      "default_model": "claude-sonnet-5",
      "docs_url": "https://platform.claude.com/docs/en/api/messages",
      "extra_headers": {
        "Authorization": "",
        "x-api-key": "${LUBANCODE_API_KEY}",
        "anthropic-version": "2023-06-01"
      },
      "extra_body": {
        "thinking": { "type": "adaptive" }
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "context_window": 1000000,
          "max_output": 128000,
          "default_think": "medium",
          "capabilities": { "reasoning": true, "tools": true, "image": true },
          "variants": {
            "low": { "description": "较快", "extra_body": { "output_config": { "effort": "low" } } },
            "medium": { "description": "默认", "extra_body": { "output_config": { "effort": "medium" } } },
            "high": { "description": "较深", "extra_body": { "output_config": { "effort": "high" } } },
            "extra": { "description": "更深", "extra_body": { "output_config": { "effort": "extra" } } },
            "max": { "description": "最大思考", "extra_body": { "output_config": { "effort": "max" } } }
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "context_window": 1000000,
          "max_output": 128000,
          "default_think": "high",
          "capabilities": { "reasoning": true, "tools": true, "image": true },
          "variants": {
            "low": { "description": "较快", "extra_body": { "output_config": { "effort": "low" } } },
            "medium": { "description": "均衡", "extra_body": { "output_config": { "effort": "medium" } } },
            "high": { "description": "默认", "extra_body": { "output_config": { "effort": "high" } } },
            "extra": { "description": "更深", "extra_body": { "output_config": { "effort": "extra" } } },
            "max": { "description": "最大思考", "extra_body": { "output_config": { "effort": "max" } } }
          }
        }
      }
    },
    "minimax": {
      "name": "MiniMax",
      "description": "MiniMax OpenAI-compatible Chat API",
      "wire": "chat_completions",
      "base_url": "https://api.minimax.io/v1",
      "key_env": "MINIMAX_API_KEY",
      "default_model": "MiniMax-M3",
      "model_reasoning_effort": "high",
      "docs_url": "https://platform.minimax.io/docs/api-reference/text-openai-api",
      "extra_body": {
        "thinking": { "type": "adaptive" },
        "reasoning_split": true
      },
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax M3",
          "context_window": 1000000,
          "max_output": 131072,
          "default_think": "high",
          "capabilities": { "reasoning": true, "tools": true, "image": true, "video": true },
          "variants": {
            "none": {
              "description": "关闭思考",
              "extra_body": { "thinking": { "type": "disabled" } }
            },
            "high": {
              "description": "自适应思考",
              "extra_body": { "thinking": { "type": "adaptive" } }
            }
          }
        }
      }
    },
