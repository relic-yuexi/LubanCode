{
  "schemaVersion": 1,
  "id": "http-recall",
  "version": "0.1.0",
  "entry": "main.lua",
  "hooks": [
    {
      "hookPoint": "PostUser",
      "name": "knowledge.recall_http",
      "handler": "recall",
      "priority": 100,
      "match": {"origin": "human", "purpose": "interactive"},
      "capabilities": ["http", "state", "context", "log"],
      "failurePolicy": "keep_original",
      "limits": {"activeTimeoutMs": 2000}
    }
  ]
}
