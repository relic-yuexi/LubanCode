{
  "schema": 1,
  "description": "项目记忆检索固定评测集:应命中与不应命中的 query/entry 对,中英混写、符号名、路径、camelCase、snake_case、同词不同模块干扰、stale/conflict/archived/expired、cwd scope 命中与越区。改检索器前后各跑一遍,数字进 CI 防长歪。",
  "entries": [
    {"id": "fact.agent-loop-request-flow", "kind": "fact", "title": "AgentLoop 请求路径", "summary": "AgentLoop::Run 组装请求并驱动工具循环", "keywords": ["AgentLoop", "AgentLoop::Run", "request"], "paths": ["src/agent/loop.cpp"]},
    {"id": "fact.turn-context-suffix", "kind": "fact", "title": "TurnContext 后缀机制", "summary": "BuildTurnContext 产出 SetTurnSystemSuffix 每轮注入", "keywords": ["BuildTurnContext", "SetTurnSystemSuffix", "TurnContext"], "paths": ["src/agent/loop.cpp"]},
    {"id": "fact.prompt-assembler-modules", "kind": "fact", "title": "提示词模块拼装", "summary": "AssembleSystemPrompt 按 ModuleByPath 逐模块拼系统提示", "keywords": ["AssembleSystemPrompt", "ModuleByPath", "prompts"], "paths": ["src/agent/prompt_assembler.cpp"]},
    {"id": "fact.config-merge-priority", "kind": "fact", "title": "配置四级合并", "summary": "MergeConfig 按专属环境变量/项目/全局/默认逐字段决", "keywords": ["MergeConfig", "config.json"], "paths": ["src/config/config.cpp"]},
    {"id": "fact.provider-switch", "kind": "fact", "title": "provider 切换机制", "summary": "ProviderConfig 切换后 active_provider 展开生效", "keywords": ["ProviderConfig", "active_provider", "provider"], "paths": ["src/config/config.hpp"]},
    {"id": "fact.bm25-inverted", "kind": "fact", "title": "BM25 软分检索", "summary": "RankEntries 用 TokenizeForRetrieval 分词后打 BM25 分", "keywords": ["BM25", "RankEntries", "TokenizeForRetrieval"], "paths": ["src/memory/project_memory.cpp"]},
    {"id": "fact.identifier-split", "kind": "fact", "title": "标识符拆分规则", "summary": "SplitIdentifier 拆 camelCase 与 snake_case,中文出双字", "keywords": ["camelCase", "snake_case", "SplitIdentifier"], "paths": ["src/memory/project_memory.cpp"]},
    {"id": "fact.memory-candidates", "kind": "fact", "title": "候选审阅箱", "summary": "memory-candidates 待审区,rejected 账本防死缠", "keywords": ["candidate", "rejected", "memory-candidates"], "paths": ["src/memory/project_memory.cpp"]},
    {"id": "fact.worker-lock", "kind": "fact", "title": "memory worker 争锁", "summary": "DirectoryLock 抢 worker.lock,30 秒陈锁自动清", "keywords": ["DirectoryLock", "worker.lock"], "paths": ["src/memory/project_memory.cpp"]},
    {"id": "fact.utf8-budget", "kind": "fact", "title": "预算不劈 UTF-8", "summary": "Utf8SafeLength 保证注入预算边界不劈汉字", "keywords": ["Utf8SafeLength", "budget"], "paths": ["src/memory/project_memory.cpp"]},
    {"id": "fact.sse-framing", "kind": "fact", "title": "SSE 分帧", "summary": "sse_framing 解析 event 流与残行", "keywords": ["sse", "framing", "event"], "paths": ["src/api/sse_framing.cpp"]},
    {"id": "fact.mcp-client-start", "kind": "fact", "title": "MCP 起服流程", "summary": "mcp client StartProcess 后 Initialize 再 ListTools", "keywords": ["mcp", "Initialize", "ListTools"], "paths": ["src/mcp/client.cpp"]},
    {"id": "fact.lsp-idle", "kind": "fact", "title": "LSP 闲置关停", "summary": "idle_minutes 到点关停语言服务器,再用再拉", "keywords": ["lsp", "idle_minutes"], "paths": ["src/lsp/manager.cpp"]},
    {"id": "fact.todo-tool", "kind": "fact", "title": "todo_write 只挂主表", "summary": "TodoListState 归主会话,子代理不挂", "keywords": ["todo_write", "TodoListState"], "paths": ["src/tools/todo_tool.cpp"]},
    {"id": "fact.tool-search-deferred", "kind": "fact", "title": "延迟挂载", "summary": "tool_search 超阈值后 DeferredTool 检索挂载", "keywords": ["tool_search", "DeferredTool", "threshold"], "paths": ["src/tools/tool_search.cpp"]},
    {"id": "fact.hooks-config", "kind": "fact", "title": "钩子配置", "summary": "hooks 段 pre_tool/post_tool 匹配工具名", "keywords": ["hooks", "pre_tool", "post_tool"], "paths": ["src/config/config.cpp"]},
    {"id": "fact.worktree-identity", "kind": "fact", "title": "worktree 共用项目 key", "summary": "commondir 归一后主树与 linked worktree 同 key", "keywords": ["worktree", "commondir", "gitdir"], "paths": ["src/memory/project_memory.cpp"]},
    {"id": "fact.session-store-jsonl", "kind": "fact", "title": "会话存档", "summary": "SessionStore 落 JSONL,resume 靠事件行回房", "keywords": ["SessionStore", "JSONL", "resume"], "paths": ["src/agent/session_store.cpp"]},
    {"id": "fact.compact-prefill", "kind": "fact", "title": "压缩续写坑", "summary": "compact 尾条是 assistant 时被当 prefill 续写,须补 user", "keywords": ["compact", "prefill", "continuation"], "paths": ["src/agent/compact.cpp"]},
    {"id": "fact.queue-steering", "kind": "fact", "title": "排队消息", "summary": "SteeringQueue 会话层账本,取回键投递", "keywords": ["SteeringQueue", "queue"], "paths": ["src/cli/queue_model.cpp"]},
    {"id": "fact.i18n-pairs", "kind": "fact", "title": "中英文案成对", "summary": "i18n 的 tr/trf 键中英两边都要有", "keywords": ["i18n", "tr", "trf", "language"], "paths": ["src/cli/i18n.cpp"]},
    {"id": "fact.theme-palette", "kind": "fact", "title": "主题调色板", "summary": "theme 三套内置:dark/light/plain", "keywords": ["theme", "dark", "light"], "paths": ["src/cli/theme.cpp"]},
    {"id": "fact.diff-syntax", "kind": "fact", "title": "diff 语法高亮", "summary": "diff_syntax 按行类型上色", "keywords": ["diff", "syntax", "highlight"], "paths": ["src/cli/diff_syntax.cpp"]},
    {"id": "fact.windows-path-refresh", "kind": "fact", "title": "Windows PATH 刷新", "summary": "安装器写 PATH 后刷新本进程环境", "keywords": ["PATH", "Windows", "install"], "paths": ["src/main.cpp"]},
    {"id": "fact.release-zero-warning", "kind": "fact", "title": "Release 零告警", "summary": "W4 下 Release 构建不许有告警", "keywords": ["Release", "W4", "warning"], "paths": ["CMakeLists.txt"]},
    {"id": "fact.cmake-presets", "kind": "fact", "title": "构建预设", "summary": "cmake preset 分 debug/release 两套", "keywords": ["preset", "cmake", "debug"], "paths": ["CMakePresets.json"]},
    {"id": "preference.python-package-manager", "kind": "preference", "title": "Python 包管理器", "summary": "添加 Python 依赖只用 uv add,不用 pip install", "keywords": ["Python", "uv", "pip", "pyproject"], "paths": ["pyproject.toml"]},
    {"id": "preference.node-package-manager", "kind": "preference", "title": "Node 包管理器", "summary": "前端依赖只用 yarn,不用 npm install", "keywords": ["Node", "yarn", "npm", "package.json"], "paths": ["package.json"]},
    {"id": "preference.commit-message-style", "kind": "preference", "title": "提交信息风格", "summary": "commit message 用中文写,一行说清", "keywords": ["commit", "message"], "paths": []},
    {"id": "preference.test-naming", "kind": "preference", "title": "测试命名规矩", "summary": "TEST_CASE 中文一句话说清场景", "keywords": ["TEST_CASE", "doctest", "命名"], "paths": []},
    {"id": "fact.frontend-build", "kind": "fact", "title": "前端构建入口", "summary": "web 子树用 vite build 出包", "keywords": ["vite", "build"], "paths": ["web/build.ts"], "scope": {"kind": "subtree", "value": "web"}},
    {"id": "fact.frontend-router", "kind": "fact", "title": "前端路由注册", "summary": "web 子树 spa router 集中注册", "keywords": ["router", "spa"], "paths": ["web/src/router.ts"], "scope": {"kind": "subtree", "value": "web"}},
    {"id": "fact.backend-api-schema", "kind": "fact", "title": "API schema 版本", "summary": "api 子树的 schema 版本号在 types.hpp", "keywords": ["schema", "version", "api"], "paths": ["src/api/types.hpp"], "scope": {"kind": "subtree", "value": "src/api"}},
    {"id": "fact.temp-branch-policy", "kind": "fact", "title": "临时分支规约", "summary": "临时分支统一 tmp/ 前缀,过期作废", "keywords": ["临时", "分支", "branch"], "paths": [], "expires_at": "2025-01-01"}
  ],
  "rank_only_entries": [
    {"id": "fact.archived-old-entry", "kind": "fact", "title": "旧版入口", "summary": "legacy old entry 已归档", "keywords": ["legacy", "old"], "paths": [], "status": "archived"},
    {"id": "fact.conflict-entry", "kind": "fact", "title": "冲突条目", "summary": "merge 冲突待人工裁决", "keywords": ["conflict", "merge"], "paths": [], "status": "conflict"}
  ],
  "queries": [
    {"query": "AgentLoop::Run 在哪里定义", "expect": ["fact.agent-loop-request-flow"]},
