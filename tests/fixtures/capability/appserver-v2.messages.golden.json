{
  "contract": "docs/reference/capability-contract.md §11",
  "note": "协议 2.0 报文 golden。信封为标准 JSON-RPC 2.0(出站带 jsonrpc 字段;与 1.2 的出站不带互不越界)。反向请求 id 用独立空间,与客户端请求 id 两不相干。样例中方法名为冻结合同草案,生产未接线。",
  "clientRequests": [
    {
      "direction": "client->engine",
      "jsonrpc": "2.0",
      "id": 41,
      "method": "input/submit",
      "params": {
