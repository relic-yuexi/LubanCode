# Internal JSON container retirement; no public header/ABI dependency.
get_target_property(_lc_json_hints nlohmann_json::nlohmann_json INTERFACE_INCLUDE_DIRECTORIES)
find_path(_lc_json_source_include NAMES nlohmann/json.hpp
  HINTS ${_lc_json_hints} "${nlohmann_json_SOURCE_DIR}/include" NO_DEFAULT_PATH)
if(NOT _lc_json_source_include)
  message(FATAL_ERROR "Cannot locate the actual internal JSON source headers")
endif()
file(SHA256 "${_lc_json_source_include}/nlohmann/json.hpp" _lc_json_hash)
file(SHA256 "${_lc_json_source_include}/nlohmann/detail/abi_macros.hpp" _lc_json_abi_hash)
file(READ "${CMAKE_CURRENT_LIST_DIR}/json-retirement/upstream.json" _lc_json_manifest)
set(_lc_json_version "")
foreach(_version IN ITEMS v3.11.3 v3.12.0)
  string(JSON _hash GET "${_lc_json_manifest}" "${_version}" json_sha256)
  string(JSON _abi_hash GET "${_lc_json_manifest}" "${_version}" abi_sha256)
  if(_lc_json_hash STREQUAL _hash AND _lc_json_abi_hash STREQUAL _abi_hash)
    set(_lc_json_version "${_version}")
  endif()
endforeach()
if(_lc_json_version STREQUAL "")
  message(FATAL_ERROR "Unqualified JSON source for container retirement: ${_lc_json_hash} / ${_lc_json_abi_hash}")
endif()
file(READ "${_lc_json_source_include}/nlohmann/json.hpp" _lc_json_header)
file(READ "${_lc_json_source_include}/nlohmann/detail/abi_macros.hpp" _lc_json_abi)
string(REPLACE "\r\n" "\n" _lc_json_header "${_lc_json_header}")
foreach(_part IN ITEMS create retire)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/json-retirement/${_part}-original-${_lc_json_version}.inc" _old)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/json-retirement/${_part}.inc" _new)
  string(REPLACE "\r\n" "\n" _old "${_old}")
  string(REPLACE "\r\n" "\n" _new "${_new}")
  string(FIND "${_lc_json_header}" "${_old}" _position)
  if(_position LESS 0)
    message(FATAL_ERROR "Qualified JSON ${_part} owner pattern missing")
  endif()
  string(REPLACE "${_old}" "${_new}" _lc_json_header "${_lc_json_header}")
endforeach()
foreach(_container IN ITEMS object array)
  set(_old "AllocatorType<${_container}_t> alloc;\n                    std::allocator_traits<decltype(alloc)>::destroy(alloc, ${_container});\n                    std::allocator_traits<decltype(alloc)>::deallocate(alloc, ${_container}, 1);")
  string(FIND "${_lc_json_header}" "${_old}" _position)
  if(_position LESS 0)
    message(FATAL_ERROR "Qualified JSON ${_container} retirement pairing missing")
  endif()
  string(REPLACE "${_old}" "retire_container(${_container});" _lc_json_header "${_lc_json_header}")
endforeach()
string(REPLACE "#include <algorithm>" "#include <new> // private container ownership\n#include <algorithm>" _lc_json_header "${_lc_json_header}")
# Both complete and forward headers include these ABI macros. The new ownership
# layout must never accept a system-package JSON object's unowned container.
string(FIND "${_lc_json_abi}" "json_abi ##" _position)
if(_position LESS 0)
  message(FATAL_ERROR "Qualified JSON private ABI namespace pattern missing")
endif()
string(REPLACE "json_abi ##" "lubancode_json_owner_abi ##" _lc_json_abi "${_lc_json_abi}")
set(_lc_json_overlay "${CMAKE_CURRENT_BINARY_DIR}/json-retirement/include")
file(MAKE_DIRECTORY "${_lc_json_overlay}/nlohmann/detail")
file(WRITE "${_lc_json_overlay}/nlohmann/json.hpp" "${_lc_json_header}")
file(WRITE "${_lc_json_overlay}/nlohmann/detail/abi_macros.hpp" "${_lc_json_abi}")
include_directories(BEFORE "${_lc_json_overlay}")
message(STATUS "Internal JSON ${_lc_json_version}: container-owned iterative retirement ABI")
